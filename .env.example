# ==============================================================================
# PayLock Environment Configuration Template
# Copy this file to .env and adjust variables for your local development environment.
# NEVER commit credentials or secrets to version control.
# ==============================================================================

# HTTP API Server Settings
PAYLOCK_HOST=127.0.0.1
PAYLOCK_PORT=8080

# Database Configuration (MySQL 9.x / InnoDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=paylock_db

# CORS Configuration
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Concurrency & Pool Defaults
PAYLOCK_WORKER_THREADS=4
